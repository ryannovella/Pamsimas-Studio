# Gemini API Key configuration for Pamsimas Studio
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_FALLBACK=your_fallback_gemini_api_key_here

# Permanent GitHub data-store sync for Master Data Personel (Fine-grained PAT: Contents Read & Write)
GITHUB_TOKEN=your_github_pat_here
# Optional admin PIN required for deleting personnel from master list (recommended on public HF Space)
PERSONEL_ADMIN_PIN=your_admin_pin_here
